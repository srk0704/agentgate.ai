# ── LLM API keys ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── AgentGate core ────────────────────────────────────────────────────────────
AGENTGATE_DB_PATH=./agentgate.db
AGENTGATE_POLICY_PATH=./policies.yaml
AGENTGATE_FAIL_OPEN=true
AGENTGATE_TIMEOUT_MS=5000

# ── Risk scoring thresholds ───────────────────────────────────────────────────
AGENTGATE_RISK_THRESHOLD_BLOCK=80
AGENTGATE_RISK_THRESHOLD_ESCALATE=60
AGENTGATE_INJECTION_THRESHOLD_BLOCK=70

# ── Anomaly detection thresholds ─────────────────────────────────────────────
AGENTGATE_ANOMALY_SCORE_BLOCK=80
AGENTGATE_ANOMALY_SCORE_ESCALATE=50
AGENTGATE_ANOMALY_VELOCITY_THRESHOLD=5
AGENTGATE_ANOMALY_VELOCITY_WINDOW_SEC=60

# ── Drift detection (source: Amazon agent failure taxonomy, AWS Blog 2026) ───
# Block when structural + semantic mismatch is clear
AGENTGATE_DRIFT_THRESHOLD_BLOCK=85
# Escalate for human review on ambiguous drift
AGENTGATE_DRIFT_THRESHOLD_ESCALATE=60
# Set false to use structural detection only (no LLM)
AGENTGATE_DRIFT_LLM_ENABLED=true

# ── Loop detection (source: Nygard circuit breaker, AWS SDK defaults, ───────
#   Replit incident July 2025)
AGENTGATE_LOOP_THRESHOLD_BLOCK=85
AGENTGATE_LOOP_THRESHOLD_ESCALATE=70
# 3 retries: LLM cost per retry > API retry cost
AGENTGATE_LOOP_RETRY_THRESHOLD=3
# 120s: covers most agent session durations
AGENTGATE_LOOP_WINDOW_SEC=120

# ── API security ─────────────────────────────────────────────────────────────
# Set this to protect all endpoints (except GET / and GET /health)
AGENTGATE_API_KEY=your-secret-key-here

# ── Slack notifications (optional) ───────────────────────────────────────────
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# ── Email notifications (optional) ───────────────────────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASSWORD=your-app-password
# ESCALATION_EMAIL=reviewer@company.com
